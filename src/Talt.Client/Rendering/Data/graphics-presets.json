{
  // Graphics quality presets (feature 018, contracts/graphics-settings.md). "presets" gives the effect values
  // of Low, Medium and High; the other sections give the numbers behind each value. Budgets on the
  // reference machine (integrated Radeon): High keeps 60 FPS on a 2048 map, Medium on a 4096 map.
  "presets": {
    "low": {
      "shadows": false, "shadowQuality": "low", "antiAliasing": "off", "waterEffects": true,
      "sceneryDensity": "low", "modelDetail": "low", "ambientOcclusion": "soft"
    },
    "medium": {
      "shadows": true, "shadowQuality": "medium", "antiAliasing": "msaa4", "waterEffects": true,
      "sceneryDensity": "medium", "modelDetail": "medium", "ambientOcclusion": "full"
    },
    "high": {
      "shadows": true, "shadowQuality": "high", "antiAliasing": "msaa4", "waterEffects": true,
      "sceneryDensity": "high", "modelDetail": "high", "ambientOcclusion": "full"
    }
  },
  // Cascades (1–3), shadow map size per cascade (power of two, 512–4096), shadow distance in tiles
  // (capped by the fog) and filter taps (1, 4 or 9).
  "shadowQuality": {
    "low": { "cascades": 1, "size": 1024, "distance": 180, "taps": 4 },
    "medium": { "cascades": 2, "size": 2048, "distance": 320, "taps": 4 },
    "high": { "cascades": 3, "size": 2048, "distance": 420, "taps": 9 }
  },
  // Share (0–1) of eligible tiles that get a bush or a rock near the camera.
  "sceneryDensity": { "off": 0, "low": 0.3, "medium": 0.6, "high": 1 },
  // Distance from the camera (tiles) at which models switch from detail level 0 to 1, 1 to 2 and 2 to 3
  // (level 3 is one cell per tile, for far views).
  "modelDetail": {
    "low": [ 40, 90, 180 ],
    "medium": [ 60, 140, 280 ],
    "high": [ 90, 200, 400 ]
  },
  // Strength (0–1) of ambient occlusion in corners.
  "ambientOcclusion": { "off": 0, "soft": 0.6, "full": 1 }
}
