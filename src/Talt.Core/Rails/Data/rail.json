  // Railways (feature 015, specs/015-railways/contracts/data-files.md). Every value and name is original to TALT.
  // Money in the internal unit (1 = one US dollar); distances in thousandths of a tile; days are game days (40 ticks).
  // Speeds use the road vehicles' scale (vehicles.json kmhPerTileSecond). Changing a value changes what recorded
  // sessions replay to.
  "trackTypes": [
    { "id": "normal", "nameKey": "rail.type.normal", "buildCost": 260, "removeCost": 60, "speedKmh": 160,
      "electrified": false, "color": "#8A7F70" },
    { "id": "electrified", "nameKey": "rail.type.electrified", "buildCost": 420, "removeCost": 90, "speedKmh": 240,
      "electrified": true, "color": "#7F7A74" }
  ],
  // Turning a tile of normal track into electrified track costs the difference plus this.
  "convertCostPerTile": 80,
  "slopeCost": 150,
  "signals": { "block": 600, "path": 900, "oneWayPath": 950, "removeCost": 100 },
  "bridge": { "costPerTile": 2600, "maxSpan": 24 },
  "tunnel": { "costPerTile": 4200, "maxLength": 64 },
  "depot": { "cost": 9000, "removeCost": 1500, "maintenancePerYear": 900 },
  // Yearly maintenance of one tile of track, per type (charged with the property maintenance).
  "maintenancePerTile": { "normal": 40, "electrified": 70 },
  "station": { "maxPlatforms": 8, "maxLength": 12 },
  "physics": {
    // One tile is this many millimetres (with vehicles.json's speed scale 40 km/h = 1 tile/s).
    "tileMillimetres": 11111,
    "gravityMilli": 9810,
    // A ramp (one height step over one tile) climbs this grade, per mille.
    "rampGradePermille": 25,
    "rollingResistancePermille": 3,
    // Forces are multiplied by this so trains reach speed in game time rather than real time.
    "accelerationScale": 12,
    "brakingMilliTilesPerSecond2": 1600,
    // Share of the train speed allowed on a link that turns 45° from the previous one.
    "curveSpeedPercent": 70,
    // How far beyond the braking distance a train asks for more track.
    "lookAheadMilliTiles": 1500
  },
  "stops": { "minDwellTicks": 60, "loadIntervalTicks": 10, "pullForwardTicks": 40 },
  // Route search work per tick for all trains; a train whose search does not fit waits for a later tick. A
  // train waiting at a path signal replans at most every replanTicks. Tiles owned by another train cost extra.
  "routing": { "searchNodesPerTick": 60000, "maxSearchNodes": 200000, "replanTicks": 40, "occupiedPenalty": 40000 },
  "stuck": { "noticeDays": 6 },
  "maxParts": 24,
  "maxTrainLengthMilliTiles": 20000,
