{
  // Construction balancing (feature 006, contracts/data-files.md). Internal money unit: 1 = one US dollar.
  // Changing a value changes what recorded sessions replay to.
  "startingBalance": 500000,
  // Per tile and per voxel step of height changed by a terraform action.
  "terraformStepCost": 250,
  // Per tree removed (clearing, or terraforming a wooded tile).
  "clearTreeCost": 40,
  // Per object demolished, by object kind. The prototype road network cannot be demolished (it
  // belongs to a town); its entry exists so the table names every kind.
  "demolishCosts": { "publicRoad": 0, "test": 100 },
  // How long the last action can be undone: 200 ticks = 10 seconds at normal speed.
  "undoWindowTicks": 200,
  // Highest ground a terraform action may create (voxels; the world holds up to 127).
  "maxHeight": 120,
  "maxTilesPerAction": 16384,
  "maxActionCost": 1000000000000
}
