<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Talt.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Talt.Core.Tests" />
    <!-- Hand-made maps (MapData constructor) for client tests and road benchmarks (feature 007). -->
    <InternalsVisibleTo Include="Talt.Client.Tests" />
    <InternalsVisibleTo Include="Talt.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <!-- State fingerprint (XxHash3). See specs/001-simulation-foundation/research.md R9. -->
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cargo and industry definitions (constitution VII); loaded as content/<file name>. -->
    <EmbeddedResource Include="Content\Data\*.json" WithCulture="false" LogicalName="content/%(Filename)%(Extension)" />
    <!-- Balancing data shared by the client and the headless tool (feature 006, research R13). -->
    <EmbeddedResource Include="Construction\Data\*.json" WithCulture="false" LogicalName="Talt.Core.Construction.Data.%(Filename)%(Extension)" />
    <!-- Road types, costs and limits (feature 007, data-model.md RoadRules). -->
    <EmbeddedResource Include="Roads\Data\*.json" WithCulture="false" LogicalName="Talt.Core.Roads.Data.%(Filename)%(Extension)" />
    <!-- Town building types, growth and rating balancing, name parts (feature 008, contracts/data-files.md). -->
    <EmbeddedResource Include="Towns\Data\*.json" WithCulture="false" LogicalName="Talt.Core.Towns.Data.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Stations\Data\*.json" WithCulture="false" LogicalName="Talt.Core.Stations.Data.%(Filename)%(Extension)" />
    <!-- Finance balancing (feature 011, contracts/data-files.md). -->
    <EmbeddedResource Include="Finance\Data\*.json" WithCulture="false" LogicalName="Talt.Core.Finance.Data.%(Filename)%(Extension)" />
    <!-- Road vehicle models, physics and balancing (feature 012, contracts/data-files.md). -->
    <EmbeddedResource Include="Vehicles\Data\*.json" WithCulture="false" LogicalName="Talt.Core.Vehicles.Data.%(Filename)%(Extension)" />
    <!-- Destination demand and cargo routing (feature 013, contracts/data-files.md). -->
    <EmbeddedResource Include="Demand\Data\*.json" WithCulture="false" LogicalName="Talt.Core.Demand.Data.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
