<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The GPU shader compilation test (feature 018) calls WebGPU directly. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <!-- xUnit test method names use underscores. -->
    <NoWarn>$(NoWarn);CA1707;CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Talt.Client\Talt.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared steady-state allocation check, kept in one place. -->
    <Compile Include="..\Talt.Core.Tests\TestSupport\AllocationAssert.cs" Link="TestSupport\AllocationAssert.cs" />
  </ItemGroup>

</Project>
