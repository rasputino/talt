<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- BenchmarkDotNet requires public, non-sealed benchmark classes. -->
    <NoWarn>$(NoWarn);CA1515;CA1001;CA1822</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Talt.Core\Talt.Core.csproj" />
    <!-- UI and picking benchmarks (feature 005) measure client code on the CPU, without a window. -->
    <ProjectReference Include="..\..\src\Talt.Client\Talt.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <!-- Only for the SoA vs ECS comparison (research R5); never referenced by the game. -->
    <PackageReference Include="Arch" />
  </ItemGroup>

</Project>
